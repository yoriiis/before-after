{
	"name": "before-after",
	"version": "4.0.0",
	"description": "BeforeAfter is a lightweight Javascript library to compare images in before/after view without any dependencies",
	"keywords": [
		"slider",
		"before after"
	],
	"homepage": "https://github.com/yoriiis/before-after.js",
	"bugs": "https://github.com/yoriiis/before-after.js/issues",
	"repository": "https://github.com/yoriiis/before-after.js.git",
	"license": "MIT",
	"author": "Yoriiis",
	"type": "module",
	"exports": "./lib/index.js",
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"files": [
		"lib"
	],
	"scripts": {
		"biome:check": "biome check",
		"biome:fix": "biome check --write",
		"build": "rm -rf ./types ./lib && tsc",
		"dev": "tsc --noEmit --watch",
		"test": "echo \"No test specified\" && exit 0"
	},
	"prettier": "./config/prettier.config.cjs",
	"devDependencies": {
		"@biomejs/biome": "^2.3.4",
		"postcss": "^8.5.6",
		"postcss-custom-media": "^12.0.0",
		"postcss-import": "^16.1.1",
		"postcss-nested": "^7.0.2",
		"postcss-preset-env": "^11.1.3",
		"postcss-url": "^10.1.1",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22"
	}
}
